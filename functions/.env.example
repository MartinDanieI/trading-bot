# Copia este archivo como functions/.env antes de "firebase deploy".
# Firebase lo carga como variables de entorno NO secretas.
# WHATSAPP_TOKEN y MANUAL_TRIGGER_KEY NO van aquí: se guardan con
#   firebase functions:secrets:set WHATSAPP_TOKEN
ALERT_PROVIDER=auto
TELEGRAM_CHAT_ID=
CALLMEBOT_APIKEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=573001234567
GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_TEMPLATE_HAS_BODY_PARAM=false
WHATSAPP_ALWAYS_TEMPLATE=false
ALERT_MODE=SIGNALS_ONLY
SCORE_THRESHOLD=70
COOLDOWN_HOURS=4
REPORT_TIMEZONE=America/Bogota
STATE_BACKEND=firestore
LOG_LEVEL=INFO
