# ---------- Canal de alertas ----------
# auto (telegram > callmebot > meta, según qué credenciales haya) | telegram | callmebot | meta
ALERT_PROVIDER=auto

# Telegram: token de @BotFather y chat_id de cada destinatario, separados por comas
# (cada persona escribe "hola" al bot; luego: python run_standalone.py --telegram-chat-id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clave que te da CallMeBot al activar (ver README)
CALLMEBOT_APIKEY=

# ---------- WhatsApp Cloud API (Meta for Developers) ----------
# Token de acceso (temporal de 24h para pruebas o permanente de "System User")
WHATSAPP_TOKEN=
# "Phone number ID" (NO es el número de teléfono; es un ID numérico largo)
WHATSAPP_PHONE_NUMBER_ID=
# Tu número personal destino (lo usan Meta y CallMeBot), formato internacional sin + ni espacios (Colombia: 57...)
WHATSAPP_TO=573001234567
GRAPH_API_VERSION=v25.0

# Plantilla de respaldo cuando la ventana de 24h está cerrada
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
# true si tu plantilla tiene una variable {{1}} en el cuerpo para el resumen
WHATSAPP_TEMPLATE_HAS_BODY_PARAM=false
# true para enviar SIEMPRE por plantilla (máxima fiabilidad, requiere plantilla con {{1}})
WHATSAPP_ALWAYS_TEMPLATE=false

# ---------- Estrategia ----------
# SIGNALS_ONLY (solo entradas) | HOURLY_SUMMARY (resumen cada hora)
ALERT_MODE=SIGNALS_ONLY
SCORE_THRESHOLD=70
COOLDOWN_HOURS=4
REPORT_TIMEZONE=America/Bogota

# ---------- Estado / ejecución ----------
# auto (firestore en Firebase, json en local) | firestore | json
STATE_BACKEND=auto
STATE_FILE=state/last_signals.json
DRY_RUN=false
LOG_LEVEL=INFO

# Solo Firebase: clave del endpoint manual_scan (se guarda como secreto)
MANUAL_TRIGGER_KEY=
